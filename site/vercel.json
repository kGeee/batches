{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.batches.space"
        }
      ],
      "destination": "https://batches.space/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/b/:id",
      "destination": "/app"
    },
    {
      "source": "/app/:path((?!assets/).*)",
      "destination": "/app"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/app/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
